source "https://rubygems.org"

ruby RUBY_VERSION

# Core
gem "jekyll", "~> 4.2.2"

# Fixes para Ruby 3.4 (libs que já não vêm embutidas)
gem "base64"
gem "csv"
gem "logger"
gem "bigdecimal"

# Plugins comuns (podes remover ou adicionar conforme usares no teu site)
gem "jekyll-feed", "~> 0.12"
gem "jekyll-sitemap"
gem "jekyll-seo-tag"
gem "jekyll-paginate"

# Compatibilidade com GitHub Pages (se usares esse stack também)
group :jekyll_plugins do
  gem "webrick", "~> 1.8"
end
